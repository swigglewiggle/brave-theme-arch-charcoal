{
  "manifest_version": 3,
  "name": "Arch Charcoal",
  "short_name": "Arch Charcoal",
  "description": "Custom Arch-charcoal new tab page — clock, search, particle background.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["https://search.brave.com/*"],
      "css": ["search-results.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/JetBrainsMono-Regular.ttf", "fonts/JetBrainsMono-Bold.ttf"],
      "matches": ["https://search.brave.com/*"]
    }
  ]
}
